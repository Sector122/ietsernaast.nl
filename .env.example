# Meta Pixel — Balkan region (sr, hr, bg, sl + en/de/nl fan-out)
META_PIXEL_BALKAN_ID=
META_PIXEL_BALKAN_TOKEN=

# Meta Pixel — Nordic region (sv, fi + en/de/nl fan-out)
META_PIXEL_NORDIC_ID=
META_PIXEL_NORDIC_TOKEN=

# Mixpanel — client-side analytics (project token is write-only ingestion,
# not a secret; same exposure model as the Meta Pixel ID). Required to enable
# analytics; if unset, the analytics layer is a silent no-op.
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Optional. Defaults to the EU residency host.
NEXT_PUBLIC_MIXPANEL_API_HOST=https://api-eu.mixpanel.com
# Optional. Set to 1 for verbose logging in dev.
NEXT_PUBLIC_MIXPANEL_DEBUG=
# Optional. Session Replay sampling 0–100 (default 100). Set 0 to disable.
NEXT_PUBLIC_MIXPANEL_SESSION_REPLAY_PERCENT=

# Brevo (Sendinblue) — handoff email sign-ups are upserted as contacts and
# subscribed to a list so Brevo can run the access-link / welcome sequence.
# If BREVO_API_KEY is unset, Brevo forwarding is a no-op.
#
# The contact is tagged with these text attributes — create them in Brevo
# (Contacts → Settings → Contact attributes) as type "Text" to capture them:
#   LOCALE, CLICK_ID, CTA_LOCATION, SOURCE_URL
# (If they don't exist, the contact is still created/subscribed without them.)
BREVO_API_KEY=
# Comma-separated Brevo list ID(s) to subscribe new contacts to (e.g. 3 or 3,7).
BREVO_LIST_ID=

# HMAC secret used by the Telegram bot and the local onboarding-link CLI.
# Configure the same secret in Cloudflare; never expose it as NEXT_PUBLIC_*.
ONBOARDING_LINK_SECRET=
